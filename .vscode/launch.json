{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "StockVault: website (app.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "StockVault: run everything (500 stocks)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_project.py",
            "args": ["--count", "500", "--skip-chart", "--serve"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "StockVault: current file",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
